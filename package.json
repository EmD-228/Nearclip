    "@tauri-apps/plugin-autostart": "~2.6.0",
    "@tauri-apps/plugin-barcode-scanner": "~2.5.0",
    "@tauri-apps/plugin-clipboard-manager": "~2.4.0",
    "@tauri-apps/plugin-log": "~2.10.0",
    "@tauri-apps/plugin-notification": "~2.5.0",
    "@tauri-apps/plugin-opener": "^2.6.0",
    "@tauri-apps/plugin-store": "~2.5.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^22.20.3",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.0",
    "vite": "^8.3.1"
  }
