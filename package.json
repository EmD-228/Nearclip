{
  "name": "nearclip",
  "version": "0.3.0",
  "description": "LAN-only encrypted clipboard sharing between your devices",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
